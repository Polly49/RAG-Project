# API Key for Groq Console (Get one at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Target word/token count for each chunk during text splitting
CHUNK_SIZE=400

# Overlap word/token count between adjacent chunks to maintain context boundaries
CHUNK_OVERLAP=50

# Number of initial candidate chunks retrieved by the hybrid search phase (FAISS + BM25)
TOP_K_RETRIEVE=20

# Final number of candidate chunks retained after scoring with the cross-encoder reranker
TOP_K_RERANK=5
